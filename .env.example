# Porta do navegador: Vite em dev, Hono (front + API) em produção.
PORT=3000

# Porta da API em dev, atrás do proxy do Vite.
API_PORT=3001

# Obrigatória. Assina o cookie de sessão (32+ caracteres): openssl rand -base64 48
SESSION_SECRET=

# Postgres. O de dev sobe com `bun run infra:up` (docker-compose.dev.yml). Nunca a URL de produção.
DATABASE_URL="postgresql://dev:dev@localhost:5433/logicell"
