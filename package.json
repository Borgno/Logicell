{
  "name": "logicell",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p server/tsconfig.json && vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=build-server/index.cjs",
    "start": "node build-server/index.cjs",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/compression": "^1.8.1",
    "clsx": "2.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "0.473.0",
    "multer": "^2.3.0",
    "react": "19.0.0",
    "react-data-grid": "7.0.0-beta.47",
    "react-dom": "19.0.0",
    "react-router": "7.15.1",
    "tailwind-merge": "3.5.0",
    "xlsx": "0.18.5",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.21.0",
    "morgan": "1.11.0",
    "qs": "6.15.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "22.13.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "8.5.1",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vite-tsconfig-paths": "5.1.4"
  }
}
